# ============================================================
# Configuración del Bot Fraccional IA - Binance
# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Binance API ---
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui

# Usa testnet=true para pruebas sin dinero real (recomendado al inicio)
BINANCE_TESTNET=true

# --- Parámetros de trading ---
# Par de trading, ej: BTCUSDT, ETHUSDT
TRADING_PAIR=BTCUSDT

# Porcentaje del saldo disponible a usar por operación (0.01 = 1%)
TRADE_FRACTION=0.01

# Intervalo de análisis en segundos
POLL_INTERVAL_SECONDS=60

# --- IA / Estrategia ---
# Estrategia: sma_cross | rsi | openai
STRATEGY=sma_cross

# (Solo si STRATEGY=openai) Tu API key de OpenAI
OPENAI_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
